{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(css|js))",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/admin\\.html",
      "dest": "/public/admin.html"
    },
    {
      "src": "/admin",
      "dest": "/public/admin.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/invite/(.*)",
      "dest": "server.js"
    }
  ]
}
