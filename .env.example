# Environment Configuration
NODE_ENV=production

# Database Configuration
# For Vercel deployment, use /tmp directory: /tmp/invitations.db
# For local development, use: ./data/invitations.db
DATABASE_PATH=./data/invitations.db

# Admin Authentication
ADMIN_PASSWORD=change-this-to-a-secure-password

# Application URL
# For local development: http://localhost:3000
# For production: https://your-app.vercel.app
BASE_URL=https://graduacion-eduardo.vercel.app
